pipeline {
    agent {
        label 'prod-agent'
    }

    stages {

        stage('Pull Docker Image') {
            steps {
                sh '''
                docker pull karthik19112001/website:latest
                '''
            }
        }
          stage('Create Namespace') {
            steps {
                sh '''
                kubectl --kubeconfig=/home/ubuntu/.kube/config apply -f namespace.yaml
                '''
            }
        }


          stage('Deploy to Kubernetes') {
            steps {
                sh '''
               kubectl --kubeconfig=/home/ubuntu/.kube/config apply -f deployment.yaml

               kubectl --kubeconfig=/home/ubuntu/.kube/config apply -f service.yaml

               kubectl --kubeconfig=/home/ubuntu/.kube/config get deployments

               kubectl --kubeconfig=/home/ubuntu/.kube/config get services
               '''
            }
        }
    }
}
